<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors><certificates src="system" /></trust-anchors>
    </base-config>
    <!-- Only a debuggable build trusts the CA that hostenv made for the test tailnet. -->
    <debug-overrides>
        <trust-anchors><certificates src="@raw/proof_ca" /></trust-anchors>
    </debug-overrides>
</network-security-config>
