<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Every other executable in the bundle (docs/signing.md): Electron's helper processes, which run
     JavaScript, and the helpers in Resources/helpers. Agent Desktop's engine asks for the
     Automation permission (AEDeterminePermissionToAutomateTarget) and sends Apple Events, which
     hardened runtime refuses without apple-events; macOS still asks the person first. -->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.automation.apple-events</key>
    <true/>
  </dict>
</plist>
